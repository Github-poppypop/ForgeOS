#!/usr/bin/env sh
# Blocks commits that add new source files without corresponding test files.
MISSING=0
NEW_FILES=$(git diff --cached --name-only --diff-filter=A | \
  grep -E '\.(ts|tsx)$' | \
  grep -v -E '(\.test\.|\.spec\.|__tests__|/test/|vitest|setup\.|/data/|/types/|\.config\.|\.d\.ts|node_modules|(^|/)evals/|(^|/)scripts/|(^|/)e2e/|\.stories\.)' | \
  grep -v -E '/index\.(ts|tsx)$' || true)
for FILE in $NEW_FILES; do
  BASENAME=$(basename "$FILE" | sed 's/\.\(tsx\?\)$//')
  EXT=$(echo "$FILE" | grep -q '\.tsx$' && echo tsx || echo ts)
  DIR=$(dirname "$FILE")
  TEST_PATH="$DIR/__tests__/$BASENAME.test.$EXT"
  if ! git diff --cached --name-only | grep -qF "$TEST_PATH" && ! [ -f "$TEST_PATH" ]; then
    echo "Missing test for new file: $FILE"
    echo "  Expected: $TEST_PATH"
    MISSING=1
  fi
done
if [ "$MISSING" = "1" ]; then
  echo ""
  echo "Commit blocked. Write missing test file(s), stage them, then re-commit."
  echo "See CLAUDE.md Test requirements for format."
  exit 1
fi

# ─── Secret scan (gitleaks) ───────────────────────────────────────────────
# Scans the STAGED diff (--staged) against .gitleaks.toml. The CI gate in
# .github/workflows/gitleaks.yml is the source of truth — this hook is a
# best-effort local shortcut that skips silently when gitleaks isn't installed
# (e.g. fresh clone before scripts/install-runner.sh has run). Install locally:
#   macOS:   brew install gitleaks
#   linux:   apt install gitleaks  (or download from github.com/gitleaks/gitleaks/releases)
#   windows: choco install gitleaks  (or download the .exe)
if command -v gitleaks >/dev/null 2>&1; then
  # HOME may point to /root on agent VMs where the user is agent but HOME=/root.
  # Git tries to read /root/.config/git/ignore which doesn't exist, causing gitleaks
  # to exit 1 even with no findings. Override to a writable path when needed.
  GITLEAKS_HOME="$HOME"
  if [ ! -w "$HOME" ] || [ ! -d "$HOME/.config" ] && ! mkdir -p "$HOME/.config" 2>/dev/null; then
    GITLEAKS_HOME=/home/agent
  fi
  if ! HOME="$GITLEAKS_HOME" gitleaks protect --staged --config .gitleaks.toml --redact --no-banner; then
    echo ""
    echo "  ╔══════════════════════════════════════════════════════════╗"
    echo "  ║  BLOCKED: gitleaks detected a potential secret.          ║"
    echo "  ║                                                          ║"
    echo "  ║  - If it's a real secret: remove it, rotate the credential,"
    echo "  ║    use Secret Manager / .env (gitignored) instead.       ║"
    echo "  ║  - If it's a false positive: add to .gitleaks.toml       ║"
    echo "  ║    allowlist and re-stage.                               ║"
    echo "  ╚══════════════════════════════════════════════════════════╝"
    exit 1
  fi
else
  echo "(pre-commit) gitleaks not installed — skipping local secret scan. CI gate (.github/workflows/gitleaks.yml) will catch leaks before merge."
fi
