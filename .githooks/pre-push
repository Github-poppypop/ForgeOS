#!/usr/bin/env bash
# Blocks direct pushes to main — all changes must go through a PR.
protected_branch="main"

# Normalize any stray CR from Windows shells.
normalize() {
  tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

# Git pre-push stdin format:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Remote refs that target main are rejected. Covers:
#   refs/heads/main
#   refs/heads/main
#   HEAD:main / origin/main / <sha>:main style refs when present.
while IFS= read -r line; do
  remote_ref=$(printf '%s\n' "$line" | awk '{print $3}' | normalize)
  remote_branch=$(printf '%s\n' "$remote_ref" | sed -E 's#^refs/heads/##;s#^.*:([^/]+)$#\1#')
  case "$remote_branch" in
    "$protected_branch")
      echo ""
      echo "  ╔══════════════════════════════════════════════════════╗"
      echo "  ║  ❌  BLOCKED: direct push to main is not allowed.   ║"
      echo "  ║                                                      ║"
      echo "  ║  Open a PR instead:                                  ║"
      echo "  ║    gh pr create --base main                          ║"
      echo "  ╚══════════════════════════════════════════════════════╝"
      echo ""
      exit 1
      ;;
  esac
done
exit 0
